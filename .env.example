# Copy this file to .env.local for local development (npm run dev).
# On Netlify/Vercel, add the same variables in the site's Environment variables settings instead.

# Sanity project — already your project. These identify the project only; they are not secrets.
NEXT_PUBLIC_SANITY_PROJECT_ID=n6n5dyot
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Public address of the website (used for Google/WhatsApp share links and the sitemap).
# Leave it commented out for local development (localhost is used automatically).
# On Netlify you can leave it empty too — Netlify's own address is used. Set it once you have your own domain.
# A localhost value is ignored on the live site.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Only for scripts/seed.mjs on a brand-new EMPTY dataset. Secret: never commit it, never prefix with NEXT_PUBLIC_.
# SANITY_API_TOKEN=

# The Contact form needs NO keys: it opens the customer's WhatsApp/SMS with the message ready to send.
# The receiving number is set in Studio → Business Settings.
